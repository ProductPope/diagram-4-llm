{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "diagram-4-llm",
  "version": "0.0.0",
  "identifier": "io.github.productpope.diagram-4-llm",
  "build": {
    "beforeDevCommand": "pnpm --filter @diagram-4-llm/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @diagram-4-llm/web build --mode desktop",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "diagram-4-llm",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
